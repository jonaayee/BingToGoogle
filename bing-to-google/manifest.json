{
  "manifest_version": 3,
  "name": "Bing to Google",
  "version": "1.0.0",
  "description": "Redirects Bing web search results to Google.",
  "permissions": ["declarativeNetRequestWithHostAccess"],
  "host_permissions": ["*://bing.com/*", "*://www.bing.com/*"],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "bing_search_redirect",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
